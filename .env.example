# Smart Wave Rider - Environment Variables Template
# 
# 注意: このファイルをコピーして .env.local を作成し、実際の値を設定してください。
# .env.local は .gitignore に登録されており、Git にコミットされません。

# ============================================
# kabu STATION API
# ============================================
# 注意: kabu STATION API は kabu STATION（Windows常駐アプリ）を起動した
# PC上の localhost に立つローカルAPI。クラウドURLは存在せず、クラウドから
# 直接叩くことはできない（PJ000001 §4 H-2）。
KABU_API_TOKEN=your_kabu_api_token_here
KABU_API_BASE_URL=http://localhost:18080/kabusapi  # 本番
KABU_SANDBOX_URL=http://localhost:18081/kabusapi   # 検証
KABU_API_MODE=sandbox  # sandbox or production

# ============================================
# J-Quants API
# ============================================
# V1（メールアドレス+パスワード認証）は 2026-06-01 に廃止済み。
# 現在は V2（APIキー方式）のみが有効。マイページ（ダッシュボード）で発行した
# APIキーを x-api-key ヘッダーに載せて呼び出す（scripts/step0_api_probe.py 参照）。
JQUANTS_API_KEY=your_jquants_api_key_here
JQUANTS_API_BASE_URL=https://api.jquants.com/v2

# ============================================
# Anthropic Claude API
# ============================================
CLAUDE_API_KEY=your_anthropic_api_key_here
# ニュース・適時開示の分類/抽出（大量・低コスト）は claude-haiku-4-5、
# シグナル統合・少数の高難度判断は claude-opus-5 を用いる（CLAUDE.md 参照）
CLAUDE_MODEL=claude-haiku-4-5  # or claude-opus-5

# ============================================
# Firebase Configuration (Optional)
# ============================================
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_PRIVATE_KEY_ID=your_firebase_private_key_id
FIREBASE_PRIVATE_KEY=your_firebase_private_key
FIREBASE_CLIENT_EMAIL=your_firebase_client_email
FIREBASE_CLIENT_ID=your_firebase_client_id

# ============================================
# Slack Integration (Optional)
# ============================================
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token
SLACK_CHANNEL_ID=C1234567890

# ============================================
# Discord Integration (Optional)
# ============================================
DISCORD_WEBHOOK_URL=https://discordapp.com/api/webhooks/your_webhook_url

# ============================================
# Trading Configuration
# ============================================
INITIAL_CAPITAL=1000000  # 初期資本（100万円。司令塔判断1）
MAX_LEVERAGE=2.0          # 最大レバレッジ倍率（建玉枠200万円）
# 同時保有銘柄数上限: 建玉枠200万円 ÷ 1単元あたり概算20万円前後 ≈ 8〜10銘柄。
# 分散を確保しつつ1銘柄あたりの資金集中を避けるため 8 とする（司令塔判断1・2）
MAX_POSITIONS=8
MAX_DRAWDOWN_PERCENT=15.0  # 最大ドローダウン許容度（%）

# ============================================
# System Configuration
# ============================================
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_DIR=./logs
DATA_DIR=./data

# ============================================
# Market Hours (Japan Time)
# ============================================
MARKET_OPEN_HOUR=9
MARKET_OPEN_MINUTE=0
# 2024-11-05 の東証取引時間延長により大引けは 15:30（15:25-15:30 はクロージング・オークション）
MARKET_CLOSE_HOUR=15
MARKET_CLOSE_MINUTE=30

# ============================================
# Timeframes (判断7: テクニカル系スリーブと非価格系スリーブの併存構成)
# ============================================
# テクニカル系スリーブ: 主軸=1時間足、エントリー判断=15分足
TECHNICAL_PRIMARY_TIMEFRAME=1h
TECHNICAL_ENTRY_TIMEFRAME=15m
# 非価格系スリーブ（PEAD・需給等）: 日足
NON_PRICE_SLEEVE_TIMEFRAME=1d

# ============================================
# Development/Testing
# ============================================
DEBUG=False
TEST_MODE=False
BACKTEST_MODE=False
FORWARD_TEST_MODE=False
